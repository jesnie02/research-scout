# Copy to .env and fill in. Never commit .env.

# Model used by the agent (OpenAI-compatible endpoint), as in the W44-W46 labs.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Keys for the model comparison in scripts/check_model.py.
# Cohere trial key: free, 1,000 calls/month in total - watch the budget.
COHERE_API_KEY=
GROQ_API_KEY=
# Gemini: use a project WITHOUT billing so calls stay on the free tier.
GEMINI_API_KEY=

# Free key from https://openalex.org (anonymous search may be paused).
OPENALEX_API_KEY=
